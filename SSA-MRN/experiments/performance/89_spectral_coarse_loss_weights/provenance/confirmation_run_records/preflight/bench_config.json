{
  "experiment": 90,
  "title": "모델 내부 축소·확대를 데이터셋 방식(23탭 보간, MTF 블러 + 솎음)으로 교체",
  "status": "계획",
  "improvement": "판단 보류",
  "registered": "2026-11-20",
  "issue": 203,
  "research_track": "performance",
  "experimenter": "이병현",
  "hypothesis": "Matching the model-internal resampling to the dataset operators (23-tap interpolation for the MS / LRPAN upsampling, the MTF degradation for the LRPAN, an anti-aliased internal downsampling) improves RR over the same-seed 89 confirmed model (variant N).",
  "plan_context": "final-model plan (2026-11-19): 88 K2D -> 89 (W2 2x2, lambda, c) -> 90 (this) -> final model with seeds 43 and 44; single seed 42 per stage, validation selection, test reported only",
  "base_recipe": "89 confirmed: W2 2x2 (convT), 88 K2D (full-size 2x2 C2MS at constant lr 1e-4 for 120 epochs -> 83 K2 factorization -> 30-epoch cosine 1e-4 -> 1e-6 with a new Adam), selection by minimum original-scale validation MSE",
  "loss": {
    "form": "per-pixel L1 + c x per-pixel L1 on 2x coarser pairs + lambda x spectral loss (1 - cos)",
    "spectral_weight": 1.2,
    "coarse_weight": 0.25,
    "source": "89 selection: lambda* 1.2 (selection_A.json), c* 0.25 (selection_B_reduced.json, reduced c range by user decision 2026-11-20)"
  },
  "w2_out_impl": "convT",
  "variants": {
    "N": "unchanged (bilinear, align_corners=True); the 89 confirmation model and the control of A, B, C",
    "A": "upsample1 (x4) and upsample100 (x2) -> 23-tap interpolation (common/interpolation, toolbox phases); performance 6 condition",
    "B": "A + downsample1 -> PAN MTF blur (genMTF 41x41 ratio 4, the training sensor PAN GNyq, replicated boundary) + x4 decimation phase 2 (= 54 Wald.pan)",
    "C": "every fixed resampling matched to the dataset (user decision 2026-11-20 23h): B + downsample100 (x2; features with the per-band MS MTF, PAN with the PAN MTF, genMTF ratio 2 = the coarse-pair kernels) at phase 0, downsample200 (features x2, MS MTF ratio 2) at phase 1, downsample2 (PAN x4, PAN MTF ratio 4) at phase 2 (data grid: 1/2 pixel k = full 2k, 1/4 pixel j = 4j + 2) + output upsampling upsample101 / upsample102 with the two stages of the dataset 23-tap interpolation (insertion phase 1, then 0)",
    "unchanged": "W2 branch 2x2 layers (learned), data / coarse pairs / projection operators"
  },
  "arms": "<v>T = full-size 2x2 trunk 120 epochs (snapshot e120), <v>K = K2 from <v>T e120, 30-epoch cosine; v in N, A, B, C; QB, GF2, WV3 seed 42 (24 trainings)",
  "order": "N of GF2, QB, WV3 first (the 89 confirmation), then A, B, C; factorized runs and evaluations first when ready; two jobs at once",
  "selection_rule": {
    "metric": "validation PSNR of <v>K (minimum original-scale validation MSE, network output without projection) minus that of NK, same sensor and seed",
    "choice": "variant (A, B, C) with the largest mean of the three sensor differences; it is chosen only if that mean is > 0 and on no sensor the validation SAM is worse than NK by more than tau_s; otherwise the next variant by the mean; if none qualifies the model stays N",
    "tau_sam_deg": {
      "QB": 0.004,
      "GF2": 0.004,
      "WV3": 0.024
    },
    "tau_basis": "as 89: 2 x sample std of the 65 seeds 42-44 best-epoch validation SAM",
    "test": "RR test (with projection) against NK, 88 K2D and C2MS-SP is measured and reported only; never used for the choice"
  },
  "confirmation_89": {
