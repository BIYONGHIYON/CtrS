{
  "experiment": 83,
  "research_track": "performance",
  "experimenter": "이병현",
  "title": "학습된 C2MS 가중치의 저랭크·depthwise 분해와 짧은 미세조정",
  "status": "계획",
  "improvement": "판단 보류",
  "registered": "2026-11-14",
  "hypothesis": "65 C2MS_L1S의 원래 해상도 backbone을 랭크 32 병목으로, W2 가지를 1x1·depthwise 3x3·1x1(CP 랭크 384 또는 256)로 분해한 뒤 65 손실로 짧게 미세조정하면, 연산 51-86%에서 65번과 같은 validation 정확도를 회복하고, 사영(K10)을 붙여 같은 시드 C2MS보다 RR 세 지표가 좋아진다.",
  "evidence": {
    "stage0_lowrank_no_finetune": "QB seed 42, 53 C2MS: backbone rank 32 test -0.063 dB (86% conv MACs), rank 24 -0.262 dB; W2 bottleneck rank 96 -0.248 dB, rank 64 -0.731 dB (activation-aware SVD); 65 C2MS_L1S the same pattern (provenance/stage0/lowrank_s42.json)",
    "stage0_cp_no_finetune": "W2 CP rank 512 -0.076 dB (95%), 384 -0.318 dB (80%), 256 -1.114 dB (65%) vs weight-space bottleneck rank 96 -1.178 dB (provenance/stage0/cp_test.json)",
    "stage0_short_finetune": "backbone rank 32 + W2 CP 384 (66%, 1,873,402 used parameters): -0.400 dB after factorization -> -0.045 dB / SAM +0.027 deg after 750 steps of batch 16 (C2MS MSE loss, lr 5e-5 cosine, about 0.7 epoch); CP 256 (51%): -1.186 -> -0.190 dB after 250 steps (stopped) (provenance/stage0/ft_test.json, ft_test.log). Local MPS, QB seed 42 only, post-hoc on test",
    "stage0_from_scratch_mimic": "depthwise blocks trained from scratch to imitate the trained W2 output converged much slower than plain blocks (1500 steps: plain 64x8 -2.36 dB, inverted residual 128x8 -4.08 dB); weak evidence (provenance/stage0/mimic.json)",
    "result_81": "65 C2MS_L1S + projection vs same-seed C2MS, 3 seeds: QB +0.072, GF2 +0.191, WV3 +0.130 dB (improvement); K10 projection equal to the full projection within 0.0003 dB",
    "result_80": "a W2 branch trained from scratch at 64x16 kept 94-103% of the C2MS gain on QB/GF2 but only 54-63% on WV3 (8 bands)"
  },
  "arms": {
    "FT0": "65 C2MS_L1S unchanged + the same fine-tuning (control for the fine-tuning itself)",
    "K1": "backbone 8 convs 64->64 3x3 -> 3x3 64->32 (no bias) + 1x1 32->64; activation-aware truncated SVD over 512 training patches",
    "K2": "K1 + W2 16 convs 128->128 3x3 -> 1x1 128->384 (no bias), depthwise 3x3 (384), 1x1 384->128; CP-ALS rank 384, 150 iterations, seed 0, balanced factors",
    "K3": "K1 + W2 at CP rank 256",
    "K2L": "K2 with 40 fine-tuning epochs (schedule-length check)"
  },
