+def _matlab_down4(image):
+    """Float64 2-D bicubic antialiased x4 reduction; QB parity verified."""
+    a = np.asarray(image, dtype=np.float64)
+    if a.ndim != 2 or not np.isfinite(a).all():
+        raise ValueError("Expected finite 2-D PAN")
+    if any(n % 4 for n in a.shape):
+        raise ValueError("PAN dimensions must be divisible by 4")
+
+    def cubic(x):
+        v = np.abs(x)
+        return (
+            ((1.5*v - 2.5)*v*v + 1) * (v <= 1)
+            + (((-.5*v + 2.5)*v - 4)*v + 2)
+            * ((v > 1) & (v <= 2))
+        )
+
+    for axis in (0, 1):
+        n = a.shape[axis]
+        u = (np.arange(n // 4) + .5) / .25 - .5
+        indices = np.floor(u - 8).astype(int)[:, None] + np.arange(18)
+        weights = .25 * cubic(.25 * (u[:, None] - indices))
+        weights /= weights.sum(axis=1, keepdims=True)
+        indices %= 2*n
+        indices = np.where(indices < n, indices, 2*n-1-indices)
+        a = np.moveaxis(a, axis, 0)
+        a = np.sum(a[indices] * weights[:, :, None], axis=1)
+        a = np.moveaxis(a, 0, axis)
+    return a
